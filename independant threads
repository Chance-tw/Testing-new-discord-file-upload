//read index

void *read_file(void *args_void){
    struct thread_args *args=(struct thread_args *)args_void;

    size_t read=BLOCK_SIZE;

    uint8_t upload_num=1;

    uint32_t start_block=0;
    for (int i=0; i<args->thread_num; i++){
        start_block+=args->all_args->thread_piece_amount[i];
    }

    char num_string[12];
    snprintf(num_string, sizeof(num_string), "%i", start_block);

    char temp_id[20];

    char time_check[]="0000000000\0";
    char time_check_blank[]="0000000000\0";
    uint8_t time_index=0;
    float sleep_time=0;

    char *file_peice=malloc(BLOCK_SIZE);
    if (!file_peice){
        printf("failed to malloc\n");
        all_working=0;

        free(args);

        return &error_return;
    }

    struct return_message *return_message=malloc(sizeof(struct return_message));
    if (!return_message){
        printf("failed to malloc\n");
        all_working=0;

        free(args);
        free(file_peice);

        return &error_return;
    }
    return_message->data=NULL;

    FILE *in_file=filecheck(args->all_args->file_name, "rb");
    if (!in_file){
        printf("failed to open file\n");
        all_working=0;

        free(args);
        free(file_peice);
        free(return_message);

        return &error_return;
    }

    fseek(in_file, args->all_args->thread_start_offset[args->thread_num], SEEK_SET);

    CURL *handle=curl_easy_init();
    if (!handle){
        printf("failed to initialize curl\n");
        all_working=0;

        free(args);
        free(file_peice);
        free(return_message);

        return &error_return;
    }

    curl_easy_setopt(handle, CURLOPT_URL, args->all_args->webhook);

    curl_mime *mime=curl_mime_init(handle);
    curl_mimepart *part=curl_mime_addpart(mime);
    curl_easy_setopt(handle, CURLOPT_MIMEPOST, mime);

    curl_mime_name(part, "files[0]");

    curl_easy_setopt(handle, CURLOPT_WRITEFUNCTION, curl_response_save);
    curl_easy_setopt(handle, CURLOPT_WRITEDATA, return_message);

    while (read==BLOCK_SIZE && all_working){
        read=fread(file_peice, 1, BLOCK_SIZE, in_file);

        printf("%i %i %i\n", args->thread_num, args->all_args->thread_piece_amount[args->thread_num], upload_num);

        if (read==0){
            break;
        }

        usleep(8*1000); //8 millisecond delay to simulate encryption

        return_message->size=0;

        curl_mime_filename(part, num_string);
        curl_mime_data(part, file_peice, read);

        while (1){
            CURLcode result=curl_easy_perform(handle);
            uint64_t return_code=0;
            curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, &return_code);

            if (return_code==429){
                printf("rate limited\n"); //ill remove later
                do{
                    //{"message": "You are being rate limited.", "retry_after": 0.3, "global": false}
                    time_check[time_index]=return_message->data[58+time_index];
                    time_index++;
                } while (time_check[time_index-1]!=',' && time_index<12);
                time_check[time_index]=0;
                time_index=0;

                sleep_time=strtof(time_check, NULL);
                if (sleep_time==0){
                    printf("failed to get valid json response\n");
                    all_working=0;

                    free(args);
                    free(file_peice);
                    free(return_message->data);
                    free(return_message);
                    curl_easy_cleanup(handle);
                    curl_mime_free(mime);

                    return &error_return;
                }
                
                memcpy(time_check, time_check_blank, sizeof(time_check_blank));

                usleep(sleep_time*1000000);

                continue;
            }
            else if (result!=CURLE_OK || return_code!=200){
                printf("failed to get valid response code\n");
                all_working=0;

                free(args);
                free(file_peice);
                free(return_message->data);
                free(return_message);
                curl_easy_cleanup(handle);
                curl_mime_free(mime);

                return &error_return;
            }
            
            break;
        }

        memcpy(temp_id, return_message->data+78, 19);

        temp_id[19]='\0';
        args->all_args->file_index_info->message_ids[start_block]=strtoull(temp_id, NULL, 10);
        if (args->all_args->file_index_info->message_ids[start_block]==0){
            printf("failed to get valid json response\n");
            all_working=0;

            free(args);
            free(file_peice);
            free(return_message->data);
            free(return_message);
            curl_easy_cleanup(handle);
            curl_mime_free(mime);

            return &error_return;
        }

        upload_num++;
        start_block++;
        snprintf(num_string, sizeof(num_string), "%i", start_block);

        if (upload_num>args->all_args->thread_piece_amount[args->thread_num]){
            break;
        }
    }

    free(args);
    free(file_peice);
    free(return_message->data);
    free(return_message);
    curl_easy_cleanup(handle);
    curl_mime_free(mime);

    return NULL;
}

struct file_info *upload(char *file_name, size_t file_size){
    char *webhook_base="https://discord.com/api/webhooks/?wait=true";
    
    struct file_info *file_index_info=malloc(sizeof(struct file_info));
    if (!file_index_info){
        return NULL;
    }
    file_index_info->file_path=file_name;

    uint8_t THREAD_COUNT=4;

    uint32_t total_blocks=(file_size+BLOCK_SIZE-1)/BLOCK_SIZE;

    if (total_blocks<THREAD_COUNT){
        THREAD_COUNT=total_blocks;
    }

    uint8_t thread_piece_amount[THREAD_COUNT]; //change to uint32_t
    size_t thread_start_offset[THREAD_COUNT];

    uint32_t base_thread_amount=total_blocks/THREAD_COUNT;
    uint8_t excess=total_blocks%THREAD_COUNT;

    size_t block_offset_total=0;
    for (int i=0; i<THREAD_COUNT; i++){
        if (excess!=0){
            thread_piece_amount[i]=base_thread_amount+1;
            excess--;
        }
        else{
            thread_piece_amount[i]=base_thread_amount;
        }

        thread_start_offset[i]=block_offset_total*BLOCK_SIZE;
        block_offset_total+=thread_piece_amount[i];
    }

    file_index_info->message_amount=total_blocks;
    file_index_info->message_ids=malloc(sizeof(uint64_t)*total_blocks);

    struct all_thread_args *all_args=malloc(sizeof(struct all_thread_args));
    all_args->file_name=file_name;
    all_args->webhook=webhook_base;
    all_args->thread_piece_amount=thread_piece_amount;
    all_args->thread_start_offset=thread_start_offset;
    all_args->file_index_info=file_index_info;


    pthread_t threads[THREAD_COUNT];

    for (int i=0; i<THREAD_COUNT; i++){
        struct thread_args *args=malloc(sizeof(struct thread_args));
        args->thread_num=i;
        args->all_args=all_args;

        if (pthread_create(&threads[i], NULL, read_file, args)!=0){
            printf("failed to create thread\n");
            all_working=0;
            free(args);
            //wait to free the rest like file_index_info until after all threads stop in case something is trying to write to it
        }
    }

    uint8_t failed=0;
    for (int i=THREAD_COUNT-1; i>=0; i--){
        void *thread_return;
        pthread_join(threads[i], &thread_return);
        if (thread_return){
            failed=1;
        }
    }

    curl_global_cleanup();
    free(all_args);

    if (failed){
        free(file_index_info->message_ids);
        free(file_index_info);

        return NULL;
    }
    return file_index_info;
}

