//handles filling the return_message struct
size_t curl_response_save(void *incoming_bytes, size_t items, size_t item_num, void *save_location){
    size_t total_bytes=items*item_num;
    struct return_message *message=(struct return_message *)save_location;

    char *try_realloc=realloc(message->data, message->size+total_bytes+1); //cjson needs a null terminator
    if (!try_realloc){
        return 0;
    }

    message->data=try_realloc;

    memcpy(&(message->data[message->size]), incoming_bytes, total_bytes);

    message->size+=total_bytes;
    message->data[message->size]='\0';

    return total_bytes;
}

