atomic_bool all_working=1;
int8_t error_return=1;

struct return_message{ //for curl to write the json to
    size_t size;
    char *data;
};

struct file_info{ //store in order needed
    uint32_t message_amount;
    char *file_path;
    uint64_t *message_ids;
};

struct all_thread_args{
    char *file_name;
    char *webhook;
    uint8_t *thread_piece_amount;
    size_t *thread_start_offset;
    struct file_info *file_index_info;
};

struct thread_args{
    int8_t thread_num;
    struct all_thread_args *all_args;
};

size_t BLOCK_SIZE=1024*1024*20;

FILE *filecheck(char *file_path, char *file_access){
    FILE *test_open=fopen(file_path, file_access);

    if (!test_open){
        printf("Invalid file path or permissions\n");
        return NULL;
    }

    return test_open;
}

