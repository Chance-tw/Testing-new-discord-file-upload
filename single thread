struct return_message{ //for curl to write the json to
    size_t size;
    char *data;
};

struct file_info{ //store in order needed
    uint32_t message_amount;
    char *file_path;
    uint64_t *message_ids;
};

struct thread_args{
    FILE *in_file;
    char *file_piece;
    curl_mimepart *part;
    pthread_mutex_t *mutex;
    pthread_cond_t *wait_notifier;
    char *num_string;
};

size_t BLOCK_SIZE=1024*1024*20;

FILE *filecheck(char *file_path, char *file_access){
    FILE *test_open=fopen(file_path, file_access);

    if (!test_open){
        printf("Invalid file path or permissions\n");
        return NULL;
    }

    return test_open;
}

//encrypt/decrypt function

//handles filling the return_message struct with data from the json response from curl 
size_t curl_response_save(void *incoming_bytes, size_t items, size_t item_num, void *save_location){
    size_t total_bytes=items*item_num;
    struct return_message *message=(struct return_message *)save_location;

    char *try_realloc=realloc(message->data, message->size+total_bytes+1); //cjson needs a null terminator
    if (!try_realloc){
        return 0;
    }

    message->data=try_realloc;

    memcpy(&(message->data[message->size]), incoming_bytes, total_bytes);

    message->size+=total_bytes;
    message->data[message->size]='\0';

    return total_bytes;
}

//write to index, return int8_t for termination status and is passed a struct file_info *

//read index

void *read_file(void *args_void){//range to read and mutex, maybe pass it curl handle so it can update stuff
    struct thread_args *args=(struct thread_args *)args_void;
    size_t read=BLOCK_SIZE;
    char *swap_ptr=NULL;

    char *reading_piece=malloc(BLOCK_SIZE);
    if (!reading_piece){
        fclose(args->in_file);
        exit(-1);
    }

    while (read==BLOCK_SIZE){
        read=fread(reading_piece, 1, BLOCK_SIZE, args->in_file);

        if (read==0){
            return NULL;
        }

        usleep(8*1000); //8 millisecond delay to simulate encryption

        pthread_mutex_lock(args->mutex);

        swap_ptr=args->file_piece;
        args->file_piece=reading_piece;
        reading_piece=swap_ptr;

        curl_mime_data(args->part, args->file_piece, read);
        curl_mime_filename(args->part, args->num_string);

        pthread_cond_signal(args->wait_notifier);
        pthread_mutex_unlock(args->mutex);
    }

    return NULL;
}

struct file_info *upload(FILE *in_file, size_t file_size, CURL *handle){
    if (file_size<BLOCK_SIZE){
        BLOCK_SIZE=file_size;
    }

    int piece_amount=(file_size+BLOCK_SIZE-1)/BLOCK_SIZE;

    char num_string[12]="1"; //for converting the index num to string

    char temp_msg_id[20]="0000000000000000000\0";

    char time_check[11]="0000000000\0";
    char time_check_blank[11]="0000000000\0";
    uint8_t time_index=0;
    float sleep_time=0;

    struct file_info *file_index_info=malloc(sizeof(struct file_info));
    if (!file_index_info){
        return NULL;
    }
    file_index_info->message_amount=1;
    file_index_info->message_ids=malloc(sizeof(uint64_t));

    char *file_peice=malloc(BLOCK_SIZE);
    if (!file_peice){
        return NULL;
    }

    struct return_message *return_message=malloc(sizeof(struct return_message));
    if (!return_message){
        return NULL;
    }
    return_message->data=NULL;
    return_message->size=0;

    char *webhook_base="https://discord.com/api/webhooks/?wait=true";
    curl_easy_setopt(handle, CURLOPT_URL, webhook_base);

    curl_mime *mime=curl_mime_init(handle);
    curl_mimepart *part=curl_mime_addpart(mime);
    curl_easy_setopt(handle, CURLOPT_MIMEPOST, mime);

    curl_mime_name(part, "files[0]");
    

    curl_easy_setopt(handle, CURLOPT_WRITEFUNCTION, curl_response_save);
    curl_easy_setopt(handle, CURLOPT_WRITEDATA, return_message);

    pthread_t reading_thread;
    pthread_mutex_t mutex=PTHREAD_MUTEX_INITIALIZER;
    pthread_cond_t wait_notifier=PTHREAD_COND_INITIALIZER;

    struct thread_args *args=malloc(sizeof(struct thread_args));
    args->in_file=in_file;
    args->file_piece=file_peice;
    args->part=part;
    args->mutex=&mutex;
    args->wait_notifier=&wait_notifier;
    args->num_string=num_string;

    pthread_mutex_lock(&mutex);

    if (pthread_create(&reading_thread, NULL, read_file, args)!=0){
        printf("Failed to create thread\n");
        return NULL;
    }
    pthread_detach(reading_thread);

    while (1){
        pthread_cond_wait(&wait_notifier, &mutex);

        while (1){
            CURLcode result=curl_easy_perform(handle);
            uint64_t return_code=0;
            curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, &return_code);
            return_message->size=0;

            if (return_code==429){
                printf("rate limited\n");
                do{
                    //{"message": "You are being rate limited.", "retry_after": 0.3, "global": false}
                    time_check[time_index]=return_message->data[58+time_index];
                    time_index++;
                } while (time_check[time_index-1]!=',');

                time_check[time_index]=0;
                time_index=0;

                sleep_time=strtof(time_check, NULL);
                if (sleep_time==0){
                    return NULL;
                }
                    
                memcpy(time_check, time_check_blank, sizeof(time_check_blank));

                usleep(sleep_time*1000000);

                continue;
            }
            else if (result!=CURLE_OK || return_code!=200){
                printf("Upload failed");
                return NULL;
            }

            break;
        }

        memcpy(temp_msg_id, return_message->data+78, 19);

        file_index_info->message_ids=realloc(file_index_info->message_ids, sizeof(uint64_t)*file_index_info->message_amount);
        file_index_info->message_ids[file_index_info->message_amount-1]=strtoull(temp_msg_id, NULL, 10);
        if (file_index_info->message_ids[file_index_info->message_amount-1]==0){
            return NULL;
        }

        file_index_info->message_amount++;
        snprintf(num_string, sizeof(num_string), "%i", file_index_info->message_amount);

        if (file_index_info->message_amount>piece_amount){
            break;
        }
    }

    curl_mime_free(mime);
    curl_easy_cleanup(handle);
    curl_global_cleanup();
    free(return_message->data);
    free(return_message);
    free(file_peice);
    fclose(in_file);
    return file_index_info;
}

