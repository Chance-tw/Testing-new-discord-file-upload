int main(int argc, char **argv){
    if (argc==1 || (argc==2 && (strcmp(argv[1], "-h")==0 || strcmp(argv[1], "--help")==0))){
        printf("Usage: file2discord [single option] [file path]\n");
        printf("\n");
        printf("Options:\n");
        printf("Note: options do not stack\n");
        printf("-h, --help                 print help screen and exit\n");
        //may and a -c --check for the index file
        //-l option to --list uploaded files
        printf("-u, --upload [file path]   path to the file being uploaded\n");
        printf("-d, --download [file path] path to the file being downloaded\n");
        printf("-o, --output [file path]   output file path for download\n");
        return 0;
    }

    uint8_t up_index=0;
    uint8_t down_index=0;
    uint8_t out_index=0;

    for (int i=1; i<argc; i++){
        if ((strcmp(argv[i], "-u")==0 || strcmp(argv[i], "--upload")==0)){
            if (down_index!=0){
                printf("Cannot do multiple operations at once\n");
                return -1;
            }

            if (out_index!=0){
                printf("No output file needed for operation\n");
                return -1;
            }

            i+=1;
            if (i>=argc){
                printf("Invalid option format\n");
                return -1;
            }

            up_index=i;
        }

        else if ((strcmp(argv[i], "-d")==0 || strcmp(argv[i], "--download")==0)){
            if (up_index!=0){
                printf("Cannot do multiple operations at once\n");
                return -1;
            }

            i+=1;

            if (i>=argc){
                printf("Invalid option format\n");
                return -1;
            }

            down_index=i;
        }

        else if ((strcmp(argv[i], "-o")==0 || strcmp(argv[i], "--output")==0)){
            if (down_index==0){
                printf("No input file\n");
                return -1;
            }

            if (up_index!=0){
                printf("No output file needed for operation\n");
                return -1;
            }

            i+=1;

            if (i>=argc){
                printf("Invalid option format\n");
                return -1;
            }

            out_index=i;
        }

        else{
            printf("Invalid option\n");
            return -1;
        }
    }

    //if check
        //run read index and return

    CURLcode result=curl_global_init(CURL_GLOBAL_SSL);
    if(result!=CURLE_OK){
        return -1;
    }

    CURL *handle=curl_easy_init();
    if (!handle){
        printf("curl initialization failed\n");
        curl_global_cleanup();
        return -1;
    }

    if (out_index==0){
        out_index=down_index;
    }

    FILE *working_file=NULL;
    struct stat file_info;

    if (up_index!=0){
        stat(argv[up_index], &file_info);

        working_file=filecheck(argv[up_index], "rb");
    }
    else{
        working_file=filecheck(argv[out_index], "wb");
    }

    if (!working_file){
        return -1;
    }

    if (up_index!=0){
        struct file_info *messages=upload(working_file, file_info.st_size, handle);
        if (!messages){
            return -1;
        }

        messages->file_path=argv[up_index];

        //return write to index
    }
